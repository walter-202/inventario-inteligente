{
  "expo": {
    "name": "Lidemoda",
    "slug": "inventario-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permitir a Lidemoda reconocer tu voz para registrar operaciones.",
        "NSMicrophoneUsageDescription": "Permitir a Lidemoda utilizar el micrófono para registrar operaciones por voz."
      }
    },
    "android": {
      "package": "com.lidemoda.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a Lidemoda utilizar la cámara para escanear productos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir a Lidemoda utilizar el micrófono para registrar operaciones por voz.",
          "speechRecognitionPermission": "Permitir a Lidemoda reconocer tu voz para registrar operaciones."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eed3bc29-2081-4b46-a346-3808e994ecc3"
      }
    },
    "owner": "walter_202"
  }
}
